# =====================================================================
# SubitoGusto — client environment
# =====================================================================
# Copy this file to `.env` (same folder) and fill in YOUR values:
#
#     cp .env.example .env
#
# `.env` is loaded by flutter_dotenv at startup (see lib/main.dart) and is
# bundled INTO the built app as an asset (see pubspec.yaml). Therefore only
# CLIENT-SAFE, public keys belong here.
#
# ⚠️  NEVER put server secrets in this file:
#       SUPABASE_SERVICE_ROLE_KEY, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET,
#       SUPABASE_DB_PASSWORD, SUPABASE_ACCESS_TOKEN, FCM service account
#     They would ship inside the app where anyone can extract them. Those
#     belong in Supabase Edge Function secrets — see
#     supabase/remote/SETUP.md (Step 5).
# =====================================================================

# Supabase — Dashboard > Project Settings > API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Stripe — Dashboard > Developers > API keys (PUBLISHABLE key only)
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
